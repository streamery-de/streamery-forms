# Files and directories that must never end up in the distributed plugin.
#
# Read by `wp dist-archive` and by 10up/action-wordpress-plugin-deploy, which is
# what the release now uses instead of the hand-maintained `distFiles` list in
# gruntfile.cjs. That list silently missed src/** (276 files, ~25.9k LOC),
# several dev configs, and the planning documents -- all of which were shipping
# inside the release zip.
#
# Everything the plugin needs at runtime must NOT be listed here:
#   assets/  includes/  libs/  database/  vendor/  composer.json
#   streamery-forms.php  plugin.php  uninstall.php  readme.txt
#   LICENSE  src/ (source + email templates) and the build configs that turn
#   src/ into assets/ (package.json, package-lock.json, webpack.config.js,
#   vite.admin.config.js, postcss.config.js, tailwind.config.js, tsconfig.json)
#
# Patterns follow gitignore semantics: a bare name like `src` matches at EVERY
# depth, so it also swallows vendor/prappo/wp-eloquent/src -- which broke the
# 1.0.0 zip with a fatal error on activation (autoload_files.php requires
# .../src/Support/helpers.php). Anything meant only for the plugin root MUST be
# written with a leading slash. Only the glob patterns below (*.zip, *.map,
# *.log, *.stories.*, .DS_Store, .git) are intentionally recursive.

# --- Version control / CI ---
.git
/.gitignore
/.gitattributes
/.github
/.distignore

# --- Sources ---
# src/ ships with the plugin on purpose: it is the human-readable source of
# assets/admin/dist and assets/blocks (WordPress.org guideline 4), and PHP reads
# src/email-templates at runtime. The build configs below ship with it so the
# assets can be rebuilt from the plugin alone. Storybook stories are dev-only.
/.storybook
*.stories.jsx
*.stories.tsx

# --- Dependencies / lockfiles ---
# composer.json ships alongside /vendor so Plugin Check can see what populated
# it (a vendor dir without composer.json is flagged as an unneeded/unexplained
# folder). composer.lock stays out: .lock is not a file type the WordPress.org
# review accepts, and the exact versions are in vendor/composer/installed.json.
/node_modules
/yarn.lock
/composer.lock

# --- Build & tooling configs ---
/webpack.config.cjs
/vite.config.js
/components.json
/phpcs.xml.dist
/phpunit.xml.dist
/phpstan.neon.dist
/.prettierrc.json
/.prettierignore
/.editorconfig
/.wp-env.json
/.envrc
/shell.nix
/.cursor

# --- Tests ---
/tests
/test-results

# --- Translations ---
# Not bundled: WordPress.org delivers translations from translate.wordpress.org.
# The .pot/.po files stay in the repository as the source for those.
/languages

# --- Docs & internal planning (not shipped to users) ---
/documentation
/planned_features
/readme-assets
/README.md
/README-boilerplate.md
/CONTRIBUTING.md
/provider-integration-plan.md
/providersetup.md

# --- Build output that must not ship ---
/release
/artifacts
*.zip
/artworks
/bin
*.map
assets/admin/dist/**/*.js.map

# --- Local noise ---
.DS_Store
*.log
*~

# Directory assets for the WordPress.org listing (banners, icons,
# screenshots). Uploaded to SVN /assets/, never part of the plugin itself.
/.wordpress-org
