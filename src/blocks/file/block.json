{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "streamery-forms/file",
	"version": "0.1.0",
	"title": "File Upload",
	"category": "widgets",
	"icon": "marker",
	"description": "File upload block for Streamery Forms.",
	"ancestor": ["streamery-forms/form"],
	"example": {},
	"attributes": {
		"style": {
			"type": "object",
			"default": {}
		},
		"hideLabel": { "type": "boolean", "default": false },
		"label": {
			"type": "string",
			"default": ""
		},
		"placeholder": {
			"type": "string",
			"default": ""
		},
		"help": {
			"type": "string",
			"default": ""
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"id": {
			"type": "string",
			"default": ""
		},
		"useCustomName": {
			"type": "boolean",
			"default": false
		},
		"useCustomId": {
			"type": "boolean",
			"default": false
		},
		"multiple": {
			"type": "boolean",
			"default": false
		},
		"acceptTypes": {
			"type": "string",
			"default": "image/*,application/pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx"
		},
		"maxFileSize": {
			"type": "number",
			"default": 0
		},
		"maxFiles": {
			"type": "number",
			"default": 5
		},
		"conditionalShow": {
			"type": "object",
			"default": null
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "streamery-forms",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}

