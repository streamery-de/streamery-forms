{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "streamery-forms/step-navigation",
	"version": "0.1.0",
	"title": "Step Navigation",
	"category": "widgets",
	"icon": "arrow-right-alt",
	"description": "Navigation buttons for multi-step forms in Streamery Forms.",
	"ancestor": ["streamery-forms/form"],
	"example": {},
	"attributes": {
		"nextLabel": {
			"type": "string",
			"default": "Next"
		},
		"prevLabel": {
			"type": "string",
			"default": "Back"
		},
		"showPrev": {
			"type": "boolean",
			"default": true
		},
		"submitLabel": {
			"type": "string",
			"default": "Submit"
		},
		"justification": {
			"type": "string",
			"default": "left",
			"enum": ["left", "center", "right", "space-between"]
		}
	},
	"supports": {
		"html": false,
		"align": true,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"textdomain": "streamery-forms",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
