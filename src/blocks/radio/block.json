{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "streamery-forms/radio",
	"version": "0.1.0",
	"title": "Radio",
	"category": "widgets",
	"icon": "marker",
	"description": "Radio block for Streamery Forms.",
	"ancestor": ["streamery-forms/form"],
	"example": {},
	"attributes": {
		"style": {
			"type": "object",
			"default": {}
		},
		"options": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"label": { "type": "string" },
					"value": { "type": "string" },
					"description": { "type": "string" },
					"imageId": { "type": "number" },
					"imageUrl": { "type": "string" },
					"imageAlt": { "type": "string" }
				}
			}
		},
		"styleVariant": {
			"type": "string",
			"default": "default"
		},
		"layout": {
			"type": "string",
			"default": "vertical"
		},
		"inlineImagePosition": { "type": "string", "default": "before" },
		"imagePosition": { "type": "string", "default": "top-left" },
		"allowCustomOption": { "type": "boolean", "default": false },
		"customOptionLabel": { "type": "string", "default": "" },
		"hideLabel": { "type": "boolean", "default": false },
		"label": { "type": "string", "default": "" },
		"placeholder": { "type": "string", "default": "" },
		"help": { "type": "string", "default": "" },
		"defaultValue": { "type": "string", "default": "" },
		"required": { "type": "boolean", "default": false },
		"name": { "type": "string", "default": "" },
		"id": { "type": "string", "default": "" },
		"useCustomName": { "type": "boolean", "default": false },
		"useCustomId": { "type": "boolean", "default": false },
		"conditionalShow": { "type": "object", "default": null }
	},
	"supports": { "html": false },
	"textdomain": "streamery-forms",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
