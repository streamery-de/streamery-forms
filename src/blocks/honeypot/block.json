{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "streamery-forms/honeypot",
	"version": "0.1.0",
	"title": "HoneyPot",
	"category": "widgets",
	"icon": "hidden",
	"description": "Hidden field for spam detection. Bots will fill this field, humans won't.",
	"ancestor": ["streamery-forms/form"],
	"example": {},
	"attributes": {
		"style": {
			"type": "object",
			"default": {}
		},
		"fieldName": {
			"type": "string",
			"default": "website"
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"id": {
			"type": "string",
			"default": ""
		},
		"useCustomName": {
			"type": "boolean",
			"default": false
		},
		"useCustomId": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "streamery-forms",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}

