{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "streamery-forms/step",
	"version": "0.1.0",
	"title": "Step",
	"category": "widgets",
	"icon": "editor-ol",
	"description": "Step container block for multi-step forms in Streamery Forms.",
	"ancestor": ["streamery-forms/form"],
	"example": {},
	"attributes": {
		"title": {
			"type": "string",
			"default": "Step"
		},
		"stepId": {
			"type": "string",
			"default": ""
		},
		"conditionalShow": {
			"type": "object",
			"default": null
		}
	},
	"usesContext": ["streamery-forms/activeStep"],
	"supports": {
		"html": false,
		"spacing": {
			"padding": true,
			"blockGap": true
		},
		"color": {
			"background": true,
			"text": true
		},
		"border": {
			"color": true,
			"radius": true,
			"width": true
		},
		"layout": {
			"allowSwitching": false,
			"allowInheriting": false,
			"default": {
				"type": "default",
				"orientation": "vertical"
			}
		}
	},
	"textdomain": "streamery-forms",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
