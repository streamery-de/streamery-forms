{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "streamery-forms/form",
	"version": "0.1.0",
	"title": "Form",
	"category": "widgets",
	"icon": "smiley",
	"description": "Form Wrapper block for Streamery Forms.",
	"example": {},
	"attributes": {
		"spacing": {
			"type": "object",
			"default": {
				"padding": 0,
				"margin": 0,
				"blockGap": "var:preset|spacing|40"
			}
		},
		"formTitle": {
			"type": "string",
			"default": ""
		},
		"mailboxId": {
			"type": "string",
			"default": "1"
		},
		"formId": {
			"type": "string",
			"default": ""
		},
		"skin": {
			"type": "string",
			"default": "default"
		},
		"providerIds": {
			"type": "array",
			"default": [],
			"items": {
				"type": "number"
			}
		},
		"providerOverrides": {
			"type": "object",
			"default": {}
		},
		"successView": {
			"type": "boolean",
			"default": false
		},
		"successMessage": {
			"type": "string",
			"default": ""
		},
		"errorMessage": {
			"type": "string",
			"default": ""
		},
		"redirectUrl": {
			"type": "string",
			"default": ""
		},
		"formSettings": {
			"type": "object",
			"default": {}
		},
		"activeStep": {
			"type": "number",
			"default": 0
		}
	},
	"providesContext": {
		"streamery-forms/activeStep": "activeStep",
		"streamery-forms/formId": "formId"
	},
	"supports": {
		"anchor": true,
		"html": true,
		"align": ["wide", "full"],
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"color": {
			"background": true,
			"text": true
		},
		"border": {
			"color": true,
			"radius": true,
			"width": true
		},
		"shadow": true,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontWeight": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		},
		"customClassName": true,
		"__experimentalExposeControlsToChildren": true,
		"layout": {
			"allowSwitching": true,
			"allowInheriting": false,
			"default": {
				"type": "default",
				"orientation": "vertical"
			}
		}
	},
	"textdomain": "streamery-forms",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}